<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_order_portal_content" inherit_id="sale.sale_order_portal_content" priority="17">
        <xpath expr="//div[@id='content']/div[@id='informations']/div[@id='customer_info']" position="after">
            <div class="alert alert-info alert-dismissable css_non_editable_mode_hidden o_not_editable" t-ignore="True" role="status">
                <p>
                    <strong>Template Header:</strong> this content will appear on all quotations using this template.
                </p>

                <p class="text-muted">
                    Titles with style <i>Heading 1</i> and <i>Heading 2</i> will be used to generate the table of content automatically.
                </p>
            </div>

            <div id="header_template_description"
                 t-raw="sale_order.render_template_field(sale_order.header_template_description, 'header')"
                 class="oe_structure" />

            <div id="website_description"
                 t-field="sale_order.website_description"
                 class="oe_structure" />

            <div id="footer_template_description"
                 t-raw="sale_order.render_template_field(sale_order.footer_template_description, 'footer')"
                 class="oe_structure" />
        </xpath>

        <xpath expr="//div[@id='content']/section[@id='details']" position="after">
            <div class="alert alert-info alert-dismissable css_non_editable_mode_hidden o_not_editable" t-ignore="True" role="status">
                <p>
                    <strong>Template Footers:</strong> this content will appear on all quotations using this template.
                </p>

                <p class="text-muted">
                    Titles with style <i>Heading 1</i> and <i>Heading 2</i> will be used to generate the table of content automatically.
                </p>
            </div>
        </xpath>
    </template>
</odoo>

