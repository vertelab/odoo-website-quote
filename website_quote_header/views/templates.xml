<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="so_portal_header_footer" name="SO Portal Header Footer" inherit_id="sale_quotation_builder.sale_order_portal_content_inherit_sale_quotation_builder">
        <!-- Add header before the website_description, but i dont think we need this again because the template also have header -->
        <xpath expr="//div[@t-field='sale_order.website_description']" position="before">
            <div class="alert alert-info alert-dismissible mt16 css_non_editable_mode_hidden o_not_editable" t-ignore="True" role="status">
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"/>
                <p>
                    <strong>Template Header:</strong> this content will appear on all quotations using this template.
                </p>
            </div>
            <div
                id="header_template_description"
                t-field="sale_order.header_template_description"
                class="oe_no_empty"
            />
        </xpath>

<!--        <xpath expr="//div[@t-field='sale_order.website_description']" position="after">-->
<!--            <div class="alert alert-info alert-dismissible mt16 css_non_editable_mode_hidden o_not_editable" t-ignore="True" role="status">-->
<!--                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"/>-->
<!--                <p>-->
<!--                    <strong>Template Footer:</strong> this content will appear on all quotations using this template.-->
<!--                </p>-->
<!--            </div>-->
<!--            <div-->
<!--                id="footer_template_description"-->
<!--                t-field="sale_order.footer_template_description"-->
<!--                class="oe_no_empty"-->
<!--            />-->
<!--        </xpath>-->

        <xpath expr="//section[@id='terms']" position="before">
            <div class="alert alert-info mt16" t-ignore="True" role="status">
                <p>
                    <strong>Template Footer:</strong> this content will appear on all quotations using this template.
                </p>
                <p class="text-muted">
                    Titles with style <i>Heading 2</i> and <i>Heading 3</i> will be used to generate the table of content automatically.
                </p>
            </div>
            <div
                id="footer_template_description"
                t-field="sale_order.footer_template_description"
                class="oe_no_empty"
            />
        </xpath>
    </template>
</odoo>

